DEPLOY_DATA_DIR=./data

# Confirms creating the first admin account in the console, and lets scripts and CI call
# the API as "Authorization: Bearer <token>". The console itself signs in with that account.
DEPLOY_ADMIN_TOKEN=
DEPLOY_HOST=127.0.0.1
DEPLOY_PORT=8000

# Numbered release directories kept per project after a successful deployment
DEPLOY_KEEP_RELEASES=5
